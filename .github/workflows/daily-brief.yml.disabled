name: PeopleOS Brief Daily

on:
  # 7:00 AM IST = 01:30 UTC
  schedule:
    - cron: "30 1 * * *"

  # Manual trigger with mode selection
  workflow_dispatch:
    inputs:
      mode:
        description: "generate_today | dry_run | test_email | send_live | backfill_initial"
        required: false
        default: "dry_run"
      test_email:
        description: "Test email address (for test_email mode)"
        required: false
        default: ""
      force:
        description: "Force regeneration even if issue exists (true/false)"
        required: false
        default: "false"

jobs:
  generate-and-publish:
    name: Generate & Publish Brief
    runs-on: ubuntu-latest

    # Allow workflow to commit back to repo
    permissions:
      contents: write

    env:
      GROQ_API_KEY_1:                    ${{ secrets.GROQ_API_KEY_1 }}
      GROQ_API_KEY_2:                    ${{ secrets.GROQ_API_KEY_2 }}
      GROQ_API_KEY_3:                    ${{ secrets.GROQ_API_KEY_3 }}
      TAVILY_API_KEY:                    ${{ secrets.TAVILY_API_KEY }}
      RESEND_API_KEY:                    ${{ secrets.RESEND_API_KEY }}
      SUPABASE_URL:                      ${{ secrets.SUPABASE_URL }}
      SUPABASE_ANON_KEY:                 ${{ secrets.SUPABASE_ANON_KEY }}
      SUPABASE_SERVICE_ROLE_KEY:         ${{ secrets.SUPABASE_SERVICE_ROLE_KEY }}
      NEWSLETTER_FROM_EMAIL:             ${{ secrets.NEWSLETTER_FROM_EMAIL }}
      NEWSLETTER_REPLY_TO:               ${{ secrets.NEWSLETTER_REPLY_TO }}
      BASE_URL:                          ${{ secrets.BASE_URL }}
      ADMIN_TEST_EMAIL:                  ${{ secrets.ADMIN_TEST_EMAIL }}
      NEWSLETTER_NAME:                   "PeopleOS Brief"
      ARCHIVE_RETENTION_DAYS:            "180"
      SECTION_SEARCH_DELAY_SECONDS:      "3"
      GROQ_SECTION_DELAY_SECONDS:        "15"
      GROQ_RETRY_DELAY_SECONDS:          "20"
      GROQ_KEY_COOLDOWN_SECONDS:         "20"
      MAX_CANDIDATES_PER_SECTION:        "8"
      MAX_SNIPPET_CHARS:                 "300"
      MAX_GROQ_RETRIES_PER_SECTION:      "3"

    steps:
      - name: Checkout repo
        uses: actions/checkout@v4
        with:
          token: ${{ secrets.GITHUB_TOKEN }}

      - name: Set up Python 3.11
        uses: actions/setup-python@v5
        with:
          python-version: "3.11"

      - name: Install dependencies
        run: pip install -r requirements.txt

      - name: Validate required environment
        run: |
          python -c "
          import os, sys
          required = ['GROQ_API_KEY_1', 'TAVILY_API_KEY']
          missing = [v for v in required if not os.getenv(v)]
          if missing:
              print(f'FATAL: Missing secrets: {missing}', file=sys.stderr)
              sys.exit(1)
          keys = sum(1 for i in (1,2,3) if os.getenv(f'GROQ_API_KEY_{i}'))
          print(f'Environment OK — {keys} Groq key(s) active')
          "

      # ── SCHEDULED: generate today + send live ───────────────────
      - name: Generate today's issue (scheduled)
        if: github.event_name == 'schedule'
        run: python newsletter/main.py --generate-today

      - name: Send live newsletter (scheduled)
        if: github.event_name == 'schedule'
        run: python newsletter/main.py --send-live
        env:
          RESEND_API_KEY: ${{ secrets.RESEND_API_KEY }}

      # ── MANUAL: generate_today ───────────────────────────────────
      - name: Generate today (manual)
        if: github.event_name == 'workflow_dispatch' && inputs.mode == 'generate_today'
        run: |
          FLAGS=""
          if [ "${{ inputs.force }}" = "true" ]; then FLAGS="--force"; fi
          python newsletter/main.py --generate-today $FLAGS

      # ── MANUAL: dry_run ──────────────────────────────────────────
      - name: Dry run (manual)
        if: github.event_name == 'workflow_dispatch' && inputs.mode == 'dry_run'
        run: python newsletter/main.py --dry-run

      # ── MANUAL: test_email ───────────────────────────────────────
      - name: Test email (manual)
        if: github.event_name == 'workflow_dispatch' && inputs.mode == 'test_email' && inputs.test_email != ''
        run: python newsletter/main.py --test "${{ inputs.test_email }}"

      # ── MANUAL: send_live ────────────────────────────────────────
      # Safety: send_live from manual trigger is intentional — admin chose it
      - name: Live send (manual — admin confirmed)
        if: github.event_name == 'workflow_dispatch' && inputs.mode == 'send_live'
        run: python newsletter/main.py --send-live

      # ── MANUAL: backfill_initial ─────────────────────────────────
      - name: Backfill initial 3 days (manual)
        if: github.event_name == 'workflow_dispatch' && inputs.mode == 'backfill_initial'
        run: |
          FLAGS=""
          if [ "${{ inputs.force }}" = "true" ]; then FLAGS="--force"; fi
          python newsletter/main.py --backfill-initial $FLAGS

      # ── COMMIT GENERATED STATIC FILES ───────────────────────────
      # Always commit after generate modes (not dry_run)
      - name: Commit generated static files
        if: inputs.mode != 'dry_run' && inputs.mode != 'test_email' && inputs.mode != 'send_live'
        run: |
          TODAY=$(date +%Y-%m-%d)
          git config user.name "peopleos-brief-bot"
          git config user.email "actions@github.com"
          git add landing/data/
          git diff --staged --quiet || git commit -m "PeopleOS Brief update — $TODAY [skip ci]"
          git push || echo "Nothing to push"

      # ── PRUNE OLD ARCHIVES ───────────────────────────────────────
      # Weekly cleanup on Sundays (cron doesn't filter by day, so check manually)
      - name: Prune old archive (scheduled)
        if: github.event_name == 'schedule'
        run: python newsletter/main.py --prune-archive || echo "Prune optional — continuing"
