name: PeopleOS Brief

on:
  # 7:00 AM IST = 01:30 UTC
  schedule:
    - cron: "30 1 * * *"

  # Manual trigger — test_email provided → test mode; empty → dry-run
  workflow_dispatch:
    inputs:
      test_email:
        description: "Test email address (leave empty for dry-run)"
        required: false
        default: ""

jobs:
  send-newsletter:
    name: Send Newsletter
    runs-on: ubuntu-latest

    env:
      GROQ_API_KEY_1:            ${{ secrets.GROQ_API_KEY_1 }}
      GROQ_API_KEY_2:            ${{ secrets.GROQ_API_KEY_2 }}
      GROQ_API_KEY_3:            ${{ secrets.GROQ_API_KEY_3 }}
      TAVILY_API_KEY:            ${{ secrets.TAVILY_API_KEY }}
      RESEND_API_KEY:            ${{ secrets.RESEND_API_KEY }}
      SUPABASE_URL:              ${{ secrets.SUPABASE_URL }}
      SUPABASE_ANON_KEY:         ${{ secrets.SUPABASE_ANON_KEY }}
      SUPABASE_SERVICE_ROLE_KEY: ${{ secrets.SUPABASE_SERVICE_ROLE_KEY }}
      NEWSLETTER_FROM_EMAIL:     ${{ secrets.NEWSLETTER_FROM_EMAIL }}
      NEWSLETTER_REPLY_TO:       ${{ secrets.NEWSLETTER_REPLY_TO }}
      BASE_URL:                  ${{ secrets.BASE_URL }}
      ADMIN_TEST_EMAIL:          ${{ secrets.ADMIN_TEST_EMAIL }}
      NEWSLETTER_NAME:           "PeopleOS Brief"

    steps:
      - name: Checkout repo
        uses: actions/checkout@v4

      - name: Set up Python 3.11
        uses: actions/setup-python@v5
        with:
          python-version: "3.11"

      - name: Install dependencies
        run: pip install -r requirements.txt

      - name: Validate environment
        run: |
          python -c "
          import os, sys
          required = [
            'GROQ_API_KEY_1','TAVILY_API_KEY','RESEND_API_KEY',
            'SUPABASE_URL','SUPABASE_SERVICE_ROLE_KEY',
            'NEWSLETTER_FROM_EMAIL','BASE_URL'
          ]
          missing = [v for v in required if not os.getenv(v)]
          if missing:
            print(f'FATAL: Missing secrets: {missing}', file=sys.stderr)
            sys.exit(1)
          # Count available Groq keys
          groq_count = sum(1 for i in (1,2,3) if os.getenv(f'GROQ_API_KEY_{i}'))
          print(f'Environment OK — {groq_count} Groq key(s) active')
          "

      # --- SCHEDULED: live send ---
      - name: Run live send (scheduled)
        if: github.event_name == 'schedule'
        run: python newsletter/main.py --send-live

      # --- MANUAL: test mode if email provided ---
      - name: Run test send (manual with email)
        if: github.event_name == 'workflow_dispatch' && inputs.test_email != ''
        run: python newsletter/main.py --test "${{ inputs.test_email }}"

      # --- MANUAL: dry run if no email provided ---
      - name: Run dry-run (manual without email)
        if: github.event_name == 'workflow_dispatch' && inputs.test_email == ''
        run: python newsletter/main.py --dry-run
