{
  "version": 2,
  "builds": [
    { "src": "landing/**/*.html",         "use": "@vercel/static" },
    { "src": "landing/**/*.css",          "use": "@vercel/static" },
    { "src": "landing/**/*.js",           "use": "@vercel/static" },
    { "src": "landing/data/**",           "use": "@vercel/static" },
    { "src": "landing/assets/**",         "use": "@vercel/static" },
    { "src": "api/subscribe.py",          "use": "@vercel/python" },
    { "src": "api/unsubscribe.py",        "use": "@vercel/python" },
    { "src": "api/admin_login.py",                       "use": "@vercel/python" },
    { "src": "api/admin_trigger.py",                     "use": "@vercel/python" },
    { "src": "api/admin_status.py",                      "use": "@vercel/python" },
    { "src": "api/admin_stats.py",                       "use": "@vercel/python" },
    { "src": "api/admin_notifications.py",               "use": "@vercel/python" },
    { "src": "api/admin_notifications_mark_seen.py",     "use": "@vercel/python" },
    { "src": "api/admin_subscribers.py",                 "use": "@vercel/python" },
    { "src": "api/analytics_visit.py",                   "use": "@vercel/python" },
    { "src": "api/public_stats.py",                      "use": "@vercel/python" },
    { "src": "api/health.py",                            "use": "@vercel/python" }
  ],
  "routes": [
    { "src": "/style.css",                "dest": "/landing/style.css" },
    { "src": "/brief.css",                "dest": "/landing/brief.css" },
    { "src": "/archive.css",              "dest": "/landing/archive.css" },
    { "src": "/dashboard.js",             "dest": "/landing/dashboard.js" },
    { "src": "/subscribe.js",             "dest": "/landing/subscribe.js" },
    { "src": "/archive.js",              "dest": "/landing/archive.js" },
    { "src": "/admin.js",                "dest": "/landing/admin.js" },
    { "src": "/brief.js",               "dest": "/landing/brief.js" },
    { "src": "/data/(.*)",              "dest": "/landing/data/$1" },
    { "src": "/assets/(.*)",            "dest": "/landing/assets/$1" },
    { "src": "/api/subscribe",           "dest": "/api/subscribe.py" },
    { "src": "/api/unsubscribe",         "dest": "/api/unsubscribe.py" },
    { "src": "/api/admin/login",                       "dest": "/api/admin_login.py" },
    { "src": "/api/admin/trigger",                     "dest": "/api/admin_trigger.py" },
    { "src": "/api/admin/status",                      "dest": "/api/admin_status.py" },
    { "src": "/api/admin/stats",                       "dest": "/api/admin_stats.py" },
    { "src": "/api/admin/notifications/mark-seen",     "dest": "/api/admin_notifications_mark_seen.py" },
    { "src": "/api/admin/notifications",               "dest": "/api/admin_notifications.py" },
    { "src": "/api/admin/subscribers",                 "dest": "/api/admin_subscribers.py" },
    { "src": "/api/health",                            "dest": "/api/health.py" },
    { "src": "/api/analytics/visit",                   "dest": "/api/analytics_visit.py" },
    { "src": "/api/public/stats",                      "dest": "/api/public_stats.py" },
    { "src": "/brief/?",                 "dest": "/landing/brief/index.html" },
    { "src": "/archive/?",               "dest": "/landing/archive/index.html" },
    { "src": "/admin/dashboard/?",       "dest": "/landing/admin/dashboard/index.html" },
    { "src": "/admin/?",                 "dest": "/landing/admin/index.html" },
    { "src": "/",                        "dest": "/landing/index.html" }
  ]
}
